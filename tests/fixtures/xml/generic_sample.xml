  <pre language="javascript">console.log("hello");</pre>

  <ul>
    <li>Bullet one</li>
    <li>Bullet two</li>
  </ul>
  <ol>
    <li>Ordered one</li>
    <li>Ordered two</li>
  </ol>

  <table>
    <tr>
      <th>Name</th>
      <th>Value</th>
    </tr>
    <tr>
      <td>Alpha</td>
      <td>100</td>
    </tr>
